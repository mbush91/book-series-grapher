# Pydantic AI model selection. Provider prefixes are supported, e.g. openai:, anthropic:, google-gla:.
MODEL_NAME=openai:gpt-5.6-sol
MODEL_EFFORT=medium
# Optional separate model/effort for chapter extraction.
# EXTRACTION_MODEL_NAME=openai:gpt-5.6-sol
# EXTRACTION_MODEL_EFFORT=medium

# Set the provider key(s) used by MODEL_NAME / EXTRACTION_MODEL_NAME.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

UPLOAD_MAX_BYTES=26214400
EXTRACTION_CONCURRENCY=1

# Compose overrides these service URLs; these values are useful outside Compose.
DATABASE_URL=postgresql+asyncpg://bookgraph:bookgraph@localhost:5432/bookgraph
MCP_URL=http://localhost:8001/mcp
